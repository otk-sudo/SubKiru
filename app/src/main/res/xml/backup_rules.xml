<?xml version="1.0" encoding="utf-8"?><!--
   SubKiru はデータを端末内にのみ保存する方針のため、自動バックアップ（API 30 以下）の対象から全データを除外する。
   DB（subkiru.db）は database ドメイン、DataStore（settings / reminder_history）は file ドメインに保存される。
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
